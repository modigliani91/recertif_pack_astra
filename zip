import zipfile
import csv
import os
import shutil
from pathlib import Path

def extract_and_rezip_in_batches(zip_path, csv_path, output_dir, id_column_name='Id tiers',
                                  encoding='latin-1', batch_size=100, base_name='recertif_filtered'):
    """
    Extract only folders from a zip file whose names match client IDs in a CSV file,
    then create multiple zip files with `batch_size` folders each.
    """
    
    # Step 1: Read the CSV file and collect all client IDs
    print("Reading CSV file...")
    client_ids = set()
    
    with open(csv_path, 'r', encoding=encoding) as csvfile:
        sample = csvfile.read(4096)
        csvfile.seek(0)
        
        try:
            dialect = csv.Sniffer().sniff(sample, delimiters=',;\t')
            delimiter = dialect.delimiter
        except csv.Error:
            delimiter = ','
        
        print(f"Using delimiter: '{delimiter}'")
        reader = csv.DictReader(csvfile, delimiter=delimiter)
        
        if id_column_name not in reader.fieldnames:
            matching = [f for f in reader.fieldnames if f.strip().lower() == id_column_name.strip().lower()]
            if matching:
                id_column_name = matching[0]
                print(f"Found column: '{id_column_name}'")
            else:
                raise ValueError(f"Column '{id_column_name}' not found. Available: {reader.fieldnames}")
        
        for row in reader:
            client_id = row[id_column_name].strip()
            if client_id:
                client_ids.add(client_id)
    
    print(f"Found {len(client_ids)} unique client IDs in CSV.")
    
    # Step 2: Determine which top-level folders to extract
    print("\nScanning zip for matching folders...")
    with zipfile.ZipFile(zip_path, 'r') as zip_ref:
        top_level_folders = set()
        for name in zip_ref.namelist():
            parts = name.replace('\\', '/').split('/')
            if parts[0]:
                top_level_folders.add(parts[0])
        
        print(f"Found {len(top_level_folders)} top-level items in the zip.")
        
        folders_to_extract = []
        matched_client_ids = set()
        for folder in top_level_folders:
            folder_name = folder.strip()
            if folder_name in client_ids:
                folders_to_extract.append(folder)
                matched_client_ids.add(folder_name)
            else:
                base_name_folder = os.path.splitext(folder_name)[0]
                if base_name_folder in client_ids:
                    folders_to_extract.append(folder)
                    matched_client_ids.add(base_name_folder)
        
        print(f"Matched {len(folders_to_extract)} folders.")
    
    # Sort folders for deterministic batching
    folders_to_extract.sort()
    
    # Step 3: Create output directory
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    
    # Step 4: Create a temp directory for extraction
    temp_dir = Path('temp_extracted_clients')
    if temp_dir.exists():
        shutil.rmtree(temp_dir)
    temp_dir.mkdir(parents=True)
    
    # Step 5: Extract ALL matching folders first (or you can do it batch by batch)
    print("\nExtracting matching folders from zip...")
    with zipfile.ZipFile(zip_path, 'r') as zip_ref:
        # Build a set for fast lookup
        folders_set = set(folders_to_extract)
        for name in zip_ref.namelist():
            parts = name.replace('\\', '/').split('/')
            if parts[0] in folders_set:
                try:
                    zip_ref.extract(name, temp_dir)
                except Exception as e:
                    print(f"Warning: could not extract {name}: {e}")
    
    # Step 6: Split into batches and create zip files
    total_folders = len(folders_to_extract)
    num_batches = (total_folders + batch_size - 1) // batch_size  # ceil division
    
    print(f"\nCreating {num_batches} zip file(s) with up to {batch_size} folders each...")
    
    for batch_index in range(num_batches):
        start = batch_index * batch_size
        end = min(start + batch_size, total_folders)
        batch_folders = folders_to_extract[start:end]
        
        # Determine zip filename (with zero-padded number if multiple batches)
        if num_batches == 1:
            zip_filename = f"{base_name}.zip"
        else:
            zip_filename = f"{base_name}_part{batch_index + 1:02d}.zip"
        
        zip_filepath = output_path / zip_filename
        
        print(f"  [{batch_index + 1}/{num_batches}] Creating {zip_filename} "
              f"({len(batch_folders)} folders: {batch_folders[0]} ... {batch_folders[-1]})")
        
        with zipfile.ZipFile(zip_filepath, 'w', zipfile.ZIP_DEFLATED) as new_zip:
            for folder in batch_folders:
                folder_path = temp_dir / folder
                if not folder_path.exists():
                    print(f"    Warning: {folder} not found in temp dir, skipping.")
                    continue
                
                for root, dirs, files in os.walk(folder_path):
                    for file in files:
                        file_path = os.path.join(root, file)
                        arcname = os.path.relpath(file_path, temp_dir)
                        new_zip.write(file_path, arcname)
    
    # Step 7: Clean up
    print("\nCleaning up temporary files...")
    shutil.rmtree(temp_dir)
    
    # Report missing IDs
    missing_ids = client_ids - matched_client_ids
    if missing_ids:
        print(f"\nWarning: {len(missing_ids)} client IDs from CSV not found in zip:")
        for cid in list(missing_ids)[:20]:
            print(f"  - {cid}")
        if len(missing_ids) > 20:
            print(f"  ... and {len(missing_ids) - 20} more")
    
    print(f"\nSummary:")
    print(f"  Client IDs in CSV:      {len(client_ids)}")
    print(f"  Folders matched:        {len(folders_to_extract)}")
    print(f"  Zip files created:      {num_batches}")
    print(f"  Output directory:       {output_path.resolve()}")


if __name__ == "__main__":
    # ==== CONFIGURE THESE ====
    ZIP_PATH = "recertif.zip"
    CSV_PATH = "clients.csv"
    OUTPUT_DIR = "output_zips"          # Folder where zip files will be created
    ID_COLUMN = "Id tiers"
    CSV_ENCODING = "latin-1"
    BATCH_SIZE = 100                    # Folders per zip
    BASE_NAME = "recertif_filtered"     # Prefix for zip filenames
    # =========================
    
    extract_and_rezip_in_batches(
        zip_path=ZIP_PATH,
        csv_path=CSV_PATH,
        output_dir=OUTPUT_DIR,
        id_column_name=ID_COLUMN,
        encoding=CSV_ENCODING,
        batch_size=BATCH_SIZE,
        base_name=BASE_NAME
    )
